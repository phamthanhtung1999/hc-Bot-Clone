# Required. API_KEY is what the brief uses; OPENAI_API_KEY works too.
API_KEY=sk-your-key

# Optional: pin a vector store. Empty = find or create one named VECTOR_STORE_NAME.
VECTOR_STORE_ID=
VECTOR_STORE_NAME=optibot-kb

# Optional tuning (0 = all published articles)
HELP_CENTER_URL=https://support.optisigns.com
HELP_CENTER_LOCALE=en-us
MAX_ARTICLES=0
# OpenAI static chunking: tokens per chunk (100-4096) and overlap (<= half)
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
UPLOAD_WORKERS=4
# true = also delete store files for articles removed from the help center
PRUNE=false
# Model used by ask.py only
MODEL=gpt-5-mini
